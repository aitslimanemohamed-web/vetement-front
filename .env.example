# Copier ce fichier en .env.local pour un développement local (jamais commité).
#
# Les variables préfixées NEXT_PUBLIC_ sont intégrées au code envoyé au navigateur
# (visibles par n'importe quel visiteur du site) — ne jamais y mettre de secret.

# Adresse de base de l'API back-end, jusqu'au préfixe /api inclus. Utilisée
# UNIQUEMENT par la zone de diagnostic technique (/<langue>/diagnostic), qui
# appelle GET /api/health directement depuis le navigateur.
# En local, le back-end tourne par défaut sur http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Identifiant du commit front déployé, affiché dans la zone de diagnostic.
# Renseigné automatiquement par le pipeline de déploiement — pas de valeur réelle ici.
NEXT_PUBLIC_APP_VERSION=dev

# Réservée au serveur (jamais exposée au navigateur, pas de préfixe
# NEXT_PUBLIC_) — utilisée par les routes relais (src/app/api/auth/*) et par
# les pages rendues côté serveur pour appeler l'API NestJS serveur-à-serveur
# (US-010). Même adresse que NEXT_PUBLIC_API_URL en pratique, mais un nom
# distinct documente que cet usage-là ne doit jamais atteindre le navigateur.
INTERNAL_API_URL=http://localhost:3001/api
